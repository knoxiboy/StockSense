# ==============================================================================
# StockSense Environment Configuration Example
# Copy this file to .env and configure real credentials for production / testing.
# NEVER commit your real secrets, passwords, or SMTP credentials to Git!
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stocksense
DB_USER=postgres
DB_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stocksense

JWT_SECRET=ReplaceWithAStrongCryptographicRandomSecretKeyForTokenSigning2026!

STOCKSENSE_MAIL_DELIVERY_MODE=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-organization-notifications@gmail.com
MAIL_PASSWORD=your-app-password-not-account-password
MAIL_FROM=StockSense Security <your-organization-notifications@gmail.com>
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

STOCKSENSE_INITIAL_MANAGER_EMAIL=admin@yourcompany.com
STOCKSENSE_INITIAL_MANAGER_PASSWORD=YourSecureManagerInitialPassword123!
STOCKSENSE_INITIAL_MANAGER_NAME=System Administrator

VITE_API_BASE_URL=http://localhost:8080/api
