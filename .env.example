# ==============================================================================
# StockSense Environment Configuration Example
# Copy this file to .env and configure real credentials for production / testing.
# NEVER commit your real secrets, passwords, or SMTP credentials to Git!
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stocksense
DB_USER=postgres
DB_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/stocksense

# Security & Signing (HMAC-SHA256 Token Secret)
JWT_SECRET=ReplaceWithAStrongCryptographicRandomSecretKeyForTokenSigning2026!

# SMTP Provider Configuration (e.g. Gmail SMTP, SendGrid, Amazon SES, Mailgun)
# Set STOCKSENSE_MAIL_DELIVERY_MODE=smtp for genuine email delivery to real inboxes
# (Set STOCKSENSE_MAIL_DELIVERY_MODE=console only for local offline debugging)
STOCKSENSE_MAIL_DELIVERY_MODE=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-organization-notifications@gmail.com
MAIL_PASSWORD=your-app-password-not-account-password
MAIL_FROM=StockSense Security <your-organization-notifications@gmail.com>
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# Optional Initial Manager Bootstrap
# When configuring a fresh system without existing managers, setting these variables
# automatically creates the initial Manager account on startup.
# Once a manager exists, this bootstrap is skipped to prevent repeated creation.
STOCKSENSE_INITIAL_MANAGER_EMAIL=admin@yourcompany.com
STOCKSENSE_INITIAL_MANAGER_PASSWORD=YourSecureManagerInitialPassword123!
STOCKSENSE_INITIAL_MANAGER_NAME=System Administrator

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
